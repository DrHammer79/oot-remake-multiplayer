From 5059e4a81b3592e0a258e73d03321cf19e1ea750 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Thu, 12 Nov 2026 18:34:41 -0900
Subject: [PATCH] Co-op host save: the account save's folder and a re-mount,
 for the module

oot-remake-multiplayer's patch 0008 (issue 167 on Hookshot). host/nn_fs.c
exports two functions that hookshot_coop.dll finds by name in the exe:
hos_coop_fs_save_root (the folder the account save is mounted from) and
hos_coop_fs_save_remount (the account save mounted from another folder,
made if missing). A guest of another player's session plays from
<folder>-coop, into which the host's save comes; the module decides that
when it joins, before a save is loaded. Nothing else changes: without the
module, or with a host, the game's own save folder is used as before.
---
 host/nn_fs.c | 50 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 49 insertions(+), 1 deletion(-)

diff --git a/host/nn_fs.c b/host/nn_fs.c
index 40f2c342..b09ff6a2 100644
--- a/host/nn_fs.c
+++ b/host/nn_fs.c
@@ -879,6 +879,9 @@ static int user_mount(const char *name, const char *sub) {
     return ok;
 }
 
+/* (oot-remake-multiplayer's patch 0008) the account save's last mount (name, user folder) and, once the module asks for
+   it, the folder it is mounted from instead of user\save\<uid> (a guest's <folder>-coop; its work copy save-work\<uid>-coop) */
+static char coop_save_name[32], coop_save_uid[40], coop_save_dir[HOS_FS_PATH];
 /* (1: owned, 0: unavailable, -1: another process owns it; never remove the ownership file) */
 static int save_own(Save *s) {
     if (s->owned) return 1;
@@ -899,11 +902,19 @@ static int save_own(Save *s) {
 }
 
 static int save_mount(const char *name, const char *uid) {
-    char committed[HOS_FS_PATH], work[HOS_FS_PATH], parent[HOS_FS_PATH];
+    char committed[HOS_FS_PATH], work[HOS_FS_PATH], parent[HOS_FS_PATH], coop_uid[48];
     if (snprintf(committed, sizeof committed, "%s\\save\\%s", hos_user_dir, uid) >= (int)sizeof committed ||
         snprintf(parent, sizeof parent, "%s\\save-work", hos_user_dir) >= (int)sizeof parent ||
         !save_join(work, parent, uid)) return 0;
     AcquireSRWLockExclusive(&save_lock);
+    if (coop_save_dir[0]) {   /* (oot-remake-multiplayer's patch 0008: the module's folder, with its own work copy) */
+        snprintf(coop_uid, sizeof coop_uid, "%s-coop", uid);
+        if (snprintf(committed, sizeof committed, "%s", coop_save_dir) >= (int)sizeof committed ||
+            !save_join(work, parent, coop_uid)) {
+            ReleaseSRWLockExclusive(&save_lock);
+            return 0;
+        }
+    }
     Save *s;
     for (s = saves; s && strcmp(s->work, work); s = s->next) {}
     int live = 0, direct = s && s->direct;
@@ -995,12 +1006,49 @@ static int save_mount(const char *name, const char *uid) {
         if (!ok && s) s->direct = 1;
         AcquireSRWLockExclusive(&mount_lock);
         snprintf(save_root, sizeof save_root, "%s", committed);
+        snprintf(coop_save_name, sizeof coop_save_name, "%s", name);
+        snprintf(coop_save_uid, sizeof coop_save_uid, "%s", uid);
         ReleaseSRWLockExclusive(&mount_lock);
     }
     ReleaseSRWLockExclusive(&save_lock);
     return mounted;
 }
 
+
+/* (oot-remake-multiplayer's patch 0008, the host's save for its guests, issue 167) For hookshot_coop.dll, found by
+   name in this exe (GetProcAddress on the exe): the folder the account save is mounted from (1 when there is one),
+   and the account save mounted from another folder (made if missing; 1 when done). A guest of another player's
+   session plays from <folder>-coop, into which the host's save comes; the module decides that when it joins, before a
+   save is loaded, and the game's next reads come from there. Longshot 3.1 stages saves (a work copy, published at
+   Commit): the folder becomes the committed one and save_mount makes its own work copy, as for user\save\<uid>. */
+#ifdef _WIN32
+#define HOS_COOP_FS_EXPORT __declspec(dllexport)
+#else
+#define HOS_COOP_FS_EXPORT __attribute__((visibility("default")))
+#endif
+HOS_COOP_FS_EXPORT int hos_coop_fs_save_root(char *out, size_t cap) { return out && cap && hos_fs_save_root(out, cap); }
+HOS_COOP_FS_EXPORT int hos_coop_fs_save_remount(const char *root) {
+    char name[sizeof coop_save_name], uid[sizeof coop_save_uid], dir[HOS_FS_PATH], was[HOS_FS_PATH];
+    if (!root || !*root || strlen(root) >= sizeof dir) return 0;
+    AcquireSRWLockShared(&mount_lock);
+    snprintf(name, sizeof name, "%s", coop_save_name);
+    snprintf(uid, sizeof uid, "%s", coop_save_uid);
+    ReleaseSRWLockShared(&mount_lock);
+    if (!name[0] || !uid[0]) return 0;
+    snprintf(dir, sizeof dir, "%s", root);
+    make_dirs(dir);
+    CreateDirectoryA(dir, NULL);
+    AcquireSRWLockExclusive(&save_lock);
+    snprintf(was, sizeof was, "%s", coop_save_dir);
+    snprintf(coop_save_dir, sizeof coop_save_dir, "%s", dir);
+    ReleaseSRWLockExclusive(&save_lock);
+    if (save_mount(name, uid)) return 1;
+    AcquireSRWLockExclusive(&save_lock);   /* (not mounted: the next mount stays where it was) */
+    snprintf(coop_save_dir, sizeof coop_save_dir, "%s", was);
+    ReleaseSRWLockExclusive(&save_lock);
+    return 0;
+}
+
 /* nn::fs::IsSaveDataExisting(ApplicationId, account::Uid const&) -> bool */
 HLE(_ZN2nn2fs18IsSaveDataExistingENS_13ApplicationIdERKNS_7account3UidE) {
     char root[HOS_FS_PATH];
