diff --git a/host/hos_coop_turn.h b/host/hos_coop_turn.h
new file mode 100644
index 0000000..7d21b8e
--- /dev/null
+++ b/host/hos_coop_turn.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   The co-op module may turn the player camera (oot-remake-multiplayer, docs/hookshot.md "The camera's angles"; our patch
+   0036): the Multiplayer tab's Customize page turns the game's own camera around the player's Link, so the game's own
+   collision places the eye (a wall or a low ceiling in the way brings the eye nearer, as in play).
+
+   One optional export, hos_coop_turn, asked by hos_mouse_camera (host/mouse_native.c) on the game's thread at the start
+   of each update of the player camera (f_80644c80), before the camera reads its input, whatever the Mouse camera row is.
+   It gets the camera's yaw and pitch (degrees: yaw falls as the view turns right, pitch rises as it tilts down) and its
+   state (+0x204: 3 while it follows Link by itself, 4 while the player turns it, others: another camera owns the view).
+   1 = the camera takes the module's yaw and pitch this frame (only in states 3 and 4; the yaw is wrapped into -180..180
+   and the pitch kept in the camera's own limits), 0 = the camera as it is. A module without it: the game's camera always.
+   Asked with yaw and pitch NULL and state -1 (the view hook, each frame the camera's update has not run for 50 ms): 1 =
+   the module wants to turn the camera, so the host wakes its update (mouse_native.c hos_coop_camera_wake), 0 = leave it.
+   Nothing may change on that call.
+   Generic: any module may turn the camera, with no further Hookshot build.
+   The same file is in Hookshot's host/ through our patch and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/module_test.cpp checks it). Plain C. */
+#ifndef HOS_COOP_TURN_H
+#define HOS_COOP_TURN_H
+
+typedef int (*hos_coop_turn_fn)(float *yaw, float *pitch, int state);   /* 1: yaw and pitch replaced */
+
+#endif
diff --git a/host/mouse_native.c b/host/mouse_native.c
index 0ae8f8e..bb38c5f 100644
--- a/host/mouse_native.c
+++ b/host/mouse_native.c
@@ -116,8 +116,79 @@ void hos_mouse_native_free(int free) { InterlockedExchange(&game_free, free ? 1
    mouse both turn the camera instead of undoing each other. */
 void hos_mouse_native_stick(int held) { InterlockedExchange(&stick_held, held ? 1 : 0); }
 
+/* (patch 0036) the co-op module's angles for this camera (hos_coop_turn.h): 1 when it turned it. Only in states 3 and 4,
+   where the camera is the view and the right stick turns it; the yaw wrapped into -180..180, the pitch kept in the
+   camera's own limits, nothing written if either is not a number. */
+int hos_coop_turn_filter(float *yaw, float *pitch, int state);   /* coop_bridge.c */
+static int coop_turns(uint64_t cam) {
+    const int32_t state = geti(cam + STATE_AT);
+    float yaw = getf(cam + YAW_AT), pitch = getf(cam + PITCH_AT);
+    if (hos_coop_turn_filter(&yaw, &pitch, state) != 1) return 0;
+    if ((state != STATE_FOLLOWS && state != STATE_PLAYER) || !isfinite(yaw) || !isfinite(pitch)) return 0;
+    yaw = fmodf(yaw, 360.0f);
+    if (yaw > 180.0f) yaw -= 360.0f;
+    if (yaw < -180.0f) yaw += 360.0f;
+    const float lo = getf(cam + LIMITS_AT), hi = getf(cam + LIMITS_AT + 4);
+    if (pitch < lo) pitch = lo;
+    if (pitch > hi) pitch = hi;
+    putf(cam + YAW_AT, yaw), putf(cam + PITCH_AT, pitch);
+    return 1;
+}
+
+/* (patch 0036) Wake the camera's update for the module. f_80644c80 is the camera node's update (its vtable +344), run by
+   f_80738670 (vtable +64), which the game's node walker f_800e98c0 calls each pass unless bit 2 of the node's byte +31
+   is set. Left idle (no right stick), the camera's update stops for seconds at a time (lane runs of 2026-11-24), and
+   the pause menu's Customize page, which turns this camera, never got a call. So while the module asks for the camera
+   (hos_coop_turn with no angles, hos_coop_turn.h) and its update has not run for 50 ms, the view hook (coop_bridge.c,
+   the game's thread) clears that bit on the last camera the update ran for, and the walker runs it at its next pass.
+   Each new pair of the node's flag words (+0x18, +0x1c) is logged, at most 16 times. */
+#define NODE_FLAGS_AT 0x18
+#define NODE_SKIP_BYTE_AT 0x1f
+#define NODE_SKIP_UPDATE 0x04
+#define WAKE_AFTER_NS 50000000LL
+static volatile LONG64 coop_node, coop_node_class, coop_node_ns;   /* (the last camera hos_mouse_camera ran for) */
+static void coop_node_seen(uint64_t cam) {
+    uint64_t class_;
+    memcpy(&class_, GP(cam), 8);
+    InterlockedExchange64(&coop_node_class, (LONG64)class_);
+    InterlockedExchange64(&coop_node, (LONG64)cam);
+    InterlockedExchange64(&coop_node_ns, (LONG64)hos_now_ns());
+}
+void hos_coop_camera_wake(void) {
+    const uint64_t cam = (uint64_t)InterlockedCompareExchange64(&coop_node, 0, 0);
+    if (!cam || (LONG64)hos_now_ns() - InterlockedCompareExchange64(&coop_node_ns, 0, 0) < WAKE_AFTER_NS) return;
+    uint64_t class_;
+    memcpy(&class_, GP(cam), 8);
+    if ((LONG64)class_ != InterlockedCompareExchange64(&coop_node_class, 0, 0) || !looks_like_camera(cam)) {
+        InterlockedCompareExchange64(&coop_node, 0, (LONG64)cam);   /* (gone, or another object there now) */
+        return;
+    }
+    if (hos_coop_turn_filter(NULL, NULL, -1) != 1) return;
+    static uint32_t said[16][2];
+    static int nsaid;
+    const uint32_t flags[2] = {(uint32_t)geti(cam + NODE_FLAGS_AT), (uint32_t)geti(cam + NODE_FLAGS_AT + 4)};
+    int seen = 0;
+    for (int i = 0; i < nsaid; i++) seen |= said[i][0] == flags[0] && said[i][1] == flags[1];
+    if (!seen && nsaid < 16) {
+        said[nsaid][0] = flags[0], said[nsaid][1] = flags[1], nsaid++;
+        hos_log("coop camera: the update is quiet while the module turns the camera: node %#llx flags %08x %08x, %s",
+                (unsigned long long)cam, flags[0], flags[1],
+                flags[1] >> 24 & NODE_SKIP_UPDATE ? "its update skipped: woken" : "its update not skipped by the node");
+    }
+    volatile char *skip = (volatile char *)GP(cam + NODE_SKIP_BYTE_AT);
+    if (*skip & NODE_SKIP_UPDATE) _InterlockedAnd8(skip, (char)~NODE_SKIP_UPDATE);
+}
+
 /* f_80644c80's first line (nx2/oot_patches.py): cam is the player camera, the game's thread */
 void hos_mouse_camera(uint64_t cam) {
+    if (cam && looks_like_camera(cam)) coop_node_seen(cam);   /* (patch 0036: hos_coop_camera_wake) */
+    /* (oot-remake-multiplayer, patch 0036) the co-op module may turn the camera first (hos_coop_turn.h), whatever the
+       Mouse camera row says: its angles go in before the camera's update reads them, so the game's own collision still
+       places the eye. While it does, the mouse does not turn the camera, and its angles start from the camera's again. */
+    if (cam && looks_like_camera(cam) && coop_turns(cam)) {
+        target_ok = 0;
+        return;
+    }
     if (!cam || !native_on() || !looks_like_camera(cam)) return;
     /* Only while it is the view: following Link (3) or turned by the player (4). Aiming the slingshot in first person
        leaves this camera updating with its state 0 while another one draws (traced at Hyrule Castle); shops are reported
-- 
