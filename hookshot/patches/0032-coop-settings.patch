From 15b93ea8c3cd3f19eee78ffd17512a42b1347fc1 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Thu, 19 Nov 2026 11:58:55 -0600
Subject: [PATCH] Co-op settings: the Insert menu's settings for the module

The pause menu's Settings tab (oot-remake-multiplayer's docs/hookshot.md
"The pause menu's Settings tab"). HosCoopApi gains setting and setting_set:
the control bridge's own rx_control_setting and rx_control_setting_set
(rx_backend.c), which list the Insert menu's rows and set one as its Left and
Right do (clamped, the Quality preset to Custom, a restart noted, the options
file saved), copied field by field into HosCoopSetting. An older module reads
the API's size and goes without them.
---
 host/coop_bridge.c  | 26 ++++++++++++++++++++++++++
 host/hos_coop_api.h | 16 ++++++++++++++++
 2 files changed, 42 insertions(+)

diff --git a/host/coop_bridge.c b/host/coop_bridge.c
index 889a0716..82b70a1e 100644
--- a/host/coop_bridge.c
+++ b/host/coop_bridge.c
@@ -8,6 +8,7 @@
 #include "hos.h"
 #include "hos_coop_api.h"
 #include "hos_coop_view.h"   /* (oot-remake-multiplayer, patch 0019) */
+#include "control.h"         /* (the Insert menu's settings, as the control bridge has them) */
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -107,6 +108,30 @@ static uint64_t bridge_pad_buttons(void) { return __atomic_load_n(&hos_coop_pad,
 /* (a key held now, by virtual-key code: Windows' own, or the SDL window's keys on Linux, host/posix/display_sdl.c) */
 static int bridge_key_down(uint32_t vk) { return vk < 256 && (GetAsyncKeyState((int)vk) & 0x8000) != 0; }
 
+/* The Insert menu's settings for the module (rx_backend.c, the control bridge's own two), field by field */
+int rx_control_setting(int index, HosControlSetting *out);
+int rx_control_setting_set(const char *key, int value, HosControlSetting *out);
+static void setting_copy(HosCoopSetting *to, const HosControlSetting *from) {
+    memcpy(to->key, from->key, sizeof to->key), memcpy(to->name, from->name, sizeof to->name);
+    memcpy(to->text, from->text, sizeof to->text), memcpy(to->tab, from->tab, sizeof to->tab);
+    to->value = from->value, to->lo = from->lo, to->hi = from->hi, to->step = from->step;
+    to->restart = from->restart, to->fixed = from->fixed;
+}
+static int bridge_setting(int index, HosCoopSetting *out) {
+    HosControlSetting s;
+    memset(&s, 0, sizeof s);
+    if (!out || !rx_control_setting(index, &s)) return 0;
+    setting_copy(out, &s);
+    return 1;
+}
+static int bridge_setting_set(const char *key, int value, HosCoopSetting *out) {
+    HosControlSetting s;
+    memset(&s, 0, sizeof s);
+    if (!key || !rx_control_setting_set(key, value, &s)) return 0;
+    if (out) setting_copy(out, &s);
+    return 1;
+}
+
 static void at_exit(void) {
     if (__atomic_load_n(&state, __ATOMIC_ACQUIRE) == 2 && coop_stop) coop_stop();
 }
@@ -186,6 +211,7 @@ static void load(void) {
     api.pad_buttons = bridge_pad_buttons;
     api.key_down = bridge_key_down;
     api.scratch = bridge_scratch;
+    api.setting = bridge_setting, api.setting_set = bridge_setting_set;
     if (!start(&api)) {
         hos_log("coop: the module stays off");
         __atomic_store_n(&state, 3, __ATOMIC_RELEASE);
diff --git a/host/hos_coop_api.h b/host/hos_coop_api.h
index bc47834c..380e9553 100644
--- a/host/hos_coop_api.h
+++ b/host/hos_coop_api.h
@@ -28,6 +28,15 @@ typedef struct HosCoopCall {
     float s0;
 } HosCoopCall;
 
+/* One of the Insert menu's settings (host/control.h HosControlSetting's fields): its key in the options file, its name
+   and the value as the menu shows them, its tab; the value and its range; restart: it applies at the next start;
+   fixed: nothing to choose on this PC. */
+typedef struct HosCoopSetting {
+    char key[32], name[48], text[64], tab[16];
+    int value, lo, hi, step;
+    int restart, fixed;
+} HosCoopSetting;
+
 typedef struct HosCoopApi {
     uint32_t version;             /* HOS_COOP_API_VERSION */
     uint32_t size;                /* sizeof(HosCoopApi) */
@@ -56,6 +65,13 @@ typedef struct HosCoopApi {
        0 when they do not fit. Only with the ctx of a hook that may call(), for the next call made with it. With it,
        call() also points x8 (where a function puts a result it returns in memory) at 128 free bytes of that stack. */
     uint64_t (*scratch)(void *ctx, const void *data, size_t n);
+    /* Added with the pause menu's Settings tab (check size covers it): the Insert menu's settings, as the control
+       bridge has them (host/control.h HosControlSetting, rx_backend.c rx_control_setting). setting: the index-th row,
+       to list them (0 past the last). setting_set: that key to `value`, as the menu's Left and Right do (clamped to
+       its range, the Quality preset to Custom, a restart noted, the options file saved); 1 when set, *out its row
+       after. Any thread. */
+    int (*setting)(int index, HosCoopSetting *out);
+    int (*setting_set)(const char *key, int value, HosCoopSetting *out);
 } HosCoopApi;
 
 /* The module's exports (extern "C"). */
